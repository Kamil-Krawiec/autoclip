# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# uv
uv.lock

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Built frontend, emitted into the Python package by `npm run build`.
# Regenerated from source; a release build produces it during packaging.
backend/autoclip/static/

# AutoClip runtime artifacts
.autoclip/
*.db
*.sqlite3

# Test media (large binaries stay out of git; see tests/fixtures/README.md)
tests/fixtures/media/
tests/fixtures/**/*.mp4
tests/fixtures/**/*.mkv
tests/fixtures/**/*.webm
tests/fixtures/**/*.wav

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets — never commit
.env
.env.*
!.env.example
# OAuth client/token files. The default location is outside the repo, but a
# local AUTOCLIP_HOME used for development may point here.
secrets/

# Markdown notes and agent progress stay local.
*.[mM][dD]
